# Set to the laptop's current LAN IP before using a physical iPhone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.14:3000/api/v1
# Web defaults to localhost; override this only when the Web API runs elsewhere.
EXPO_PUBLIC_WEB_API_BASE_URL=http://localhost:3000/api/v1
# Optional override. Defaults: Web 4000ms, iOS/Android 8000ms.
EXPO_PUBLIC_API_TIMEOUT_MS=
EXPO_PUBLIC_AI_MODE=simulation
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_API_FALLBACK_TO_DEMO=true
EXPO_PUBLIC_LOG_LEVEL=info
# Populate only with contact details verified by the AMMERHA operations team.
EXPO_PUBLIC_FIRE_EMERGENCY_PHONE=
EXPO_PUBLIC_MEDICAL_EMERGENCY_PHONE=
EXPO_PUBLIC_WATER_UTILITY_PHONE=
EXPO_PUBLIC_MUNICIPAL_SERVICE_PHONE=
EXPO_PUBLIC_SOCIAL_SUPPORT_PHONE=
