NODE_ENV=development
PORT=3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
COMMISSION_RATE=0.10
URGENT_DISPATCH_RADII_KM=3,6,9
# Comma-separated production Web origins. Localhost is allowed automatically outside production.
CORS_ORIGINS=

# Firebase / Firestore
# Download from Firebase Console > Project settings > Service accounts > Generate new private key.
# Never commit the key file itself (see .gitignore).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Only needed if you rely on Application Default Credentials instead of the key file above.
# FIREBASE_PROJECT_ID=ammerha-xxxxx
