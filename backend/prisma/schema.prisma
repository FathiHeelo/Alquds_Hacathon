generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────── Enums ─────────

enum UserRole {
  customer
  technician
  admin
}

enum AccountStatus {
  active
  suspended
  frozen
}

enum RepairRequestStatus {
  open
  matched
  accepted
  cancelled
  completed
}

enum OfferStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum JobStatus {
  accepted
  scheduled
  on_the_way
  in_progress
  completed
  cancelled
}

enum Urgency {
  low
  medium
  high
}

enum Availability {
  available
  busy
  offline
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum MediaType {
  image
  video
  audio
}

enum MessageType {
  text
  image
  location
}

enum RewardTxType {
  earn
  redeem
}

enum SubscriptionPlan {
  free
  pro
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum CaseStatus {
  open
  reviewed
  dismissed
}

enum RiskLevel {
  low
  medium
  high
}

enum AdminActionType {
  review
  warn
  suspend
  freeze
  unfreeze
}

// ───────── Users ─────────

model User {
  id           String        @id @default(cuid())
  role         UserRole
  name         String
  phone        String?       @unique
  email        String?       @unique
  passwordHash String?
  status       AccountStatus @default(active)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  technicianProfile TechnicianProfile?
  subscription      Subscription?
  requests          RepairRequest[]
  offers            Offer[]
  notifications     Notification[]
  rewardTx          RewardTransaction[]
  redemptions       Redemption[]
}

model TechnicianProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  specialty          String?
  yearsExperience    Int                @default(0)
  serviceAreas       Json
  availability       Availability       @default(available)
  verificationStatus VerificationStatus @default(pending)
  isVerified         Boolean            @default(false)
  isPro              Boolean            @default(false)
  ratingAvg          Float              @default(0)
  ratingCount        Int                @default(0)
  bio                String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────── Requests ─────────

model ServiceCategory {
  id     String @id
  nameEn String
  nameAr String

  requests RepairRequest[]
}

model RepairRequest {
  id              String              @id @default(cuid())
  customerId      String
  categoryId      String
  description     String              @db.Text
  locationSummary String?
  area            String?
  lat             Float?
  lng             Float?
  urgency         Urgency             @default(medium)
  preferredTime   DateTime?
  status          RepairRequestStatus @default(open)
  aiSummary       Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  customer User            @relation(fields: [customerId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  media    RepairRequestMedia[]
  offers   Offer[]
  job      Job?

  @@index([status, categoryId])
  @@index([customerId])
}

model RepairRequestMedia {
  id        String    @id @default(cuid())
  requestId String
  url       String    @db.Text
  type      MediaType @default(image)
  createdAt DateTime  @default(now())

  request RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ───────── Offers & Jobs ─────────

model Offer {
  id           String      @id @default(cuid())
  requestId    String
  technicianId String
  price        Decimal     @db.Decimal(10, 2)
  message      String?     @db.Text
  etaMinutes   Int?
  status       OfferStatus @default(pending)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  request    RepairRequest @relation(fields: [requestId], references: [id])
  technician User          @relation(fields: [technicianId], references: [id])
  job        Job?

  @@unique([requestId, technicianId])
}

model Job {
  id           String    @id @default(cuid())
  requestId    String    @unique
  offerId      String    @unique
  customerId   String
  technicianId String
  status       JobStatus @default(accepted)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  request      RepairRequest @relation(fields: [requestId], references: [id])
  offer        Offer         @relation(fields: [offerId], references: [id])
  financial    JobFinancial?
  conversation Conversation?
  review       Review?

  @@index([customerId])
  @@index([technicianId])
}

model JobFinancial {
  id                String   @id @default(cuid())
  jobId             String   @unique
  labor             Decimal  @db.Decimal(10, 2)
  parts             Decimal  @db.Decimal(10, 2)
  subtotal          Decimal  @db.Decimal(10, 2)
  commissionRate    Decimal  @db.Decimal(5, 4)
  platformFee       Decimal  @db.Decimal(10, 2)
  total             Decimal  @db.Decimal(10, 2)
  technicianEarning Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])
}

// ───────── Chat & Notifications ─────────

model Conversation {
  id           String   @id @default(cuid())
  jobId        String   @unique
  customerId   String
  technicianId String
  createdAt    DateTime @default(now())

  job      Job       @relation(fields: [jobId], references: [id])
  messages Message[]
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType @default(text)
  body           String?     @db.Text
  payload        Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?   @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ───────── Reviews ─────────

model Review {
  id            String   @id @default(cuid())
  jobId         String   @unique
  customerId    String
  technicianId  String
  overall       Int
  quality       Int
  speed         Int
  commitment    Int
  communication Int
  comment       String?  @db.Text
  createdAt     DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([technicianId])
}

// ───────── Rewards ─────────

model RewardTransaction {
  id        String       @id @default(cuid())
  userId    String
  type      RewardTxType
  points    Int
  reason    String
  refId     String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  // Idempotent awards: one earn per (user, reason, ref).
  @@unique([userId, reason, refId])
  @@index([userId])
}

model Partner {
  id        String @id @default(cuid())
  name      String
  area      String?
  logoUrl   String?

  rewards PartnerReward[]
}

model PartnerReward {
  id         String  @id @default(cuid())
  partnerId  String
  title      String
  pointsCost Int
  active     Boolean @default(true)

  partner     Partner      @relation(fields: [partnerId], references: [id])
  redemptions Redemption[]
}

model Redemption {
  id        String   @id @default(cuid())
  userId    String
  rewardId  String
  points    Int
  code      String   @unique
  createdAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id])
  reward PartnerReward @relation(fields: [rewardId], references: [id])
}

// ───────── Pro subscription ─────────

model Subscription {
  id           String             @id @default(cuid())
  technicianId String             @unique
  plan         SubscriptionPlan   @default(free)
  status       SubscriptionStatus @default(active)
  activeFrom   DateTime?
  activeUntil  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  technician User @relation(fields: [technicianId], references: [id], onDelete: Cascade)
}

// ───────── Admin, reports & risk ─────────

model Report {
  id           String     @id @default(cuid())
  reporterId   String
  targetUserId String?
  jobId        String?
  reason       String
  details      String?    @db.Text
  status       CaseStatus @default(open)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
}

model RiskAssessment {
  id         String     @id @default(cuid())
  userId     String?
  requestId  String?
  level      RiskLevel
  score      Float?
  source     String     @default("manual")
  status     CaseStatus @default(open)
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?    @db.Text
  createdAt  DateTime   @default(now())

  flags RiskFlag[]

  @@index([status])
}

model RiskFlag {
  id           String @id @default(cuid())
  assessmentId String
  code         String
  note         String?

  assessment RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model AdminAction {
  id           String          @id @default(cuid())
  adminId      String
  targetUserId String
  action       AdminActionType
  note         String?
  createdAt    DateTime        @default(now())
}
